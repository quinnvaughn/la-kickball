{
  "name": "la-kickball",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "npm run build:server && npm run build:client",
    "build:client": "vite build && tsc --noEmit",
    "build:server": "vite build --mode server",
    "start": "NODE_ENV=production node .output/server/index.mjs",
    "preview": "NODE_ENV=production tsx ./src/server/server.ts",
    "panda": "panda codegen --config panda.config.ts",
    "panda:watch": "panda --config panda.config.ts --watch",
    "prepare": "panda codegen --config panda.config.ts",
    "generate-routes": "tsr generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/seed.mjs",
    "test": "vitest run",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "@trpc/client": "latest",
    "@trpc/server": "latest",
    "argon2": "^0.45.1",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.2.1",
    "lucide-react": "^0.545.0",
    "luxon": "^3.7.2",
    "nitro": "npm:nitro-nightly@latest",
    "postgres": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "superjson": "^2.2.6",
    "tailwindcss": "^4.1.18",
    "ts-pattern": "^5.9.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@flydotio/dockerfile": "^0.7.10",
    "@pandacss/dev": "^1.11.4",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "drizzle-kit": "1.0.0-rc.4",
    "jsdom": "^28.1.0",
    "tsx": "^4.20.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "lightningcss"
    ]
  }
}
